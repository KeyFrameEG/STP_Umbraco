@inherits UmbracoViewPage<BlockListItem>
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var row = (LatestNewsRow)Model.Content;
    var settings = (LatestNewsRowSettings)Model.Settings;
    if (settings?.Hide ?? false) { return; }
    if (row.LatestNewsItems == null || !row.LatestNewsItems.Any()) return;

    // Detect the current page
    var currentUrl = HttpContextAccessor.HttpContext.Request.Path.ToString();
    var isUpcomingEventsPage = currentUrl.Contains("UpcomingEvents", StringComparison.OrdinalIgnoreCase);
    var isJobsPage = currentUrl.Contains("Jobs", StringComparison.OrdinalIgnoreCase);

    // Pagination settings
    var pageSize = 4; // Number of items to display per page
    var currentPage = 1;
    var queryStringPage = HttpContextAccessor.HttpContext.Request.Query["page"];
    if (!string.IsNullOrEmpty(queryStringPage) && int.TryParse(queryStringPage, out currentPage))
    {
        currentPage = Math.Max(currentPage, 1);
    }
    var totalItems = row.LatestNewsItems.Count();
    var totalPages = (int)Math.Ceiling((double)totalItems / pageSize);

    // Get the items for the current page
    var itemsForPage = row.LatestNewsItems
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize)
        .ToList();
}

<div class="row">
    @foreach (var item in itemsForPage)
    {
        var rowItem = (LatestNewsItem)item.Content;

        // Conditional design for UpcomingEvents page
        if (isUpcomingEventsPage)
        {
            <!-- Upcoming Events Design -->
            <div class="col-md-6 mb-3 aos-item aos-init aos-animate" data-aos="zoom-in">
                <div class="upcomingEvents">
                    <a href="@rowItem.RedirectUrl"></a>
                    <b>Research and Studies</b>
                    <div class="upcomingimg">
                        <img alt="Upcoming Title" src="@rowItem.Image.Url()" />
                    </div>
                    <div class="upcomingdata">
                        <h4>@rowItem.Title</h4>
                        <span><i class="feather icon-calendar"></i> @rowItem.Date</span>
                        <span><i class="feather icon-clock"></i>2.00PM to 5.00PM</span>
                        <span><i class="feather icon-map-pin"></i> place of meeting will add here later</span>
                    </div>
                </div>
            </div>
        }
        else if (isJobsPage)
        {
            <!-- Jobs Page Design -->
            <div class="col-md-12 mb-4 aos-item aos-init aos-animate" data-aos="zoom-in">
                 <div class="jobsection">
                      <h3>@rowItem.Title</h3>
                      <span><i class="feather icon-calendar"></i>@rowItem.Date</span>
                      <small>Development &amp; IT</small>
                      <div class="jobDetails">@rowItem.Description</div>
                      <a href="@rowItem.RedirectUrl">Apply Now <i class="feather icon-arrow-down mx-1"></i></a>
                 </div>
            </div>
        }
        else
        {
            <!-- Default News Design -->
            <div class="col-md-6 mb-3 aos-item" data-aos="zoom-in">
                <div class="newslist d-flex align-items-end">
                    <a href="@rowItem.RedirectUrl"></a>
                    <small>@row.Title</small>
                    <strong>@rowItem.Date</strong>
                    <div class="overlaynewslist">
                        <h4>@rowItem.Title</h4>
                        <span>@rowItem.Description</span>
                    </div>
                    <img alt="News Title" src="@rowItem.Image.Url()" />
                </div>
            </div>
        }
    }
</div>

<div class="row">
    <div class="col-12 text-center">
        <nav aria-label="Page navigation">
            <ul class="pagination mt-5 justify-content-center">
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" href="?page=@i">@i</a>
                    </li>
                }
            </ul>
        </nav>
    </div>
</div>

<style>
    small{
        position: absolute;
        z-index: 3;
        background: rgb(238 120 35);
        padding: 0 20px;
        height: 36px;
        line-height: 36px;
        color: #fff;
        font-weight: 400;
        font-size: 16px;
        top: 20px;
        right: 20px;
    }
</style>