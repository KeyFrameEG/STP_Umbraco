@inherits UmbracoViewPage<BlockListItem>
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var row = (AllstartupsRow)Model.Content;
    var settings = (AllstartupsRowSettings)Model.Settings;

    if (settings?.Hide ?? false) { return; }
    if (row.AllstartupsItems == null || !row.AllstartupsItems.Any()) return;

    // Detect the current page
    var currentUrl = HttpContextAccessor.HttpContext.Request.Path.ToString();
    var isMeetingUpPage = currentUrl.Contains("MeetingUp", StringComparison.OrdinalIgnoreCase);
    var isPublicationsPage = currentUrl.Contains("Publications", StringComparison.OrdinalIgnoreCase);

    // Pagination settings
    var pageSize = 6; // Number of items to display per page
    var currentPage = 1;
    var queryStringPage = HttpContextAccessor.HttpContext.Request.Query["page"];
    if (!string.IsNullOrEmpty(queryStringPage) && int.TryParse(queryStringPage, out currentPage))
    {
        currentPage = Math.Max(currentPage, 1);
    }

    var totalItems = row.AllstartupsItems.Count();
    var totalPages = (int)Math.Ceiling((double)totalItems / pageSize);

    // Get the items for the current page
    var itemsForPage = row.AllstartupsItems
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize)
        .ToList();
}

<div class="w-bg fitlayout pt-4 mb-4 paddingabove">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-10 mb-4 aos-item" data-aos="fade-down">
                <h2 class="migatitle mb-4">@row.Title</h2>
            </div>

            @foreach (var item in itemsForPage)
            {
                var rowItem = (AllstartupsItem)item.Content;

                if (isMeetingUpPage)
                {
                    <!-- Design for MeetingUp Page -->
                    <div class="col-lg-6 mb-4">
                        <div class="activityblock">
                            <h3 class="enside">@rowItem.Title</h3>
                            <a href="@rowItem.RedirectUrl"><span class="enside">Explore more</span></a>
                            <img alt="activity name" src="@rowItem.Image.Url()">
                        </div>
                    </div>
                }
                else if (isPublicationsPage)
                {
                    <div class="col-md-6 mb-4 aos-item aos-init aos-animate" data-aos="zoom-in">
                        <div class="Publicationsblock px-3">
                            <div class="row">
                                <div class="col-3 text-center pt-4">
                                    <img alt="" src="assets/images/publication-icon.png">
                                </div>
                                <div class="col-9">
                                    <h3>@rowItem.Title</h3>
                                    <span><i class="feather icon-user"></i>@rowItem.Subtitle</span><span class="datepublish"><i class="feather icon-calendar"></i> 5 . 10 .2024</span>
                                    <div>@rowItem.Description</div>
                                    <a href="@rowItem.RedirectUrl">Explore more <i class="feather icon-arrow-right"></i></a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <!-- Default Design -->
                    <div class="col-lg-4 col-md-6 aos-item mb-3" data-aos="flip-left">
                        <div class="cardstartup">
                            <img alt="Incubators" src="@rowItem.Image.Url()" />
                            <h3>@rowItem.Title</h3>
                            <span>
                                @rowItem.Description
                            </span>
                            <a class="morestartup" href="@rowItem.RedirectUrl"><b>@rowItem.Subtitle</b></a>
                        </div>
                    </div>
                }
            }
        </div>

        <div class="row">
            <div class="col-12 mt-5 text-center">
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center">
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link" href="?page=@i">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>
