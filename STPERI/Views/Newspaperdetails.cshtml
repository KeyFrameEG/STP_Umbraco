<script src="assets/dist/caleandar/caleandar.js"></script>
<script src="assets/dist/caleandar/demo.js"></script>

<script>
document.addEventListener("DOMContentLoaded", function () {
    // Select all calendar elements
    const calendars = document.querySelectorAll("#caleandar .cld-main");
    
    // Check if there are multiple calendars
    if (calendars.length > 1) {
        // Hide the first calendar
        calendars[0].style.display = "none";
    }
});



</script>